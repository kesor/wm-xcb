#!/bin/sh
# models: dmenu, which reads the command list on stdin and writes the chosen line on stdout, then exits
# from dmenu: usage: dmenu [-bfiv] [-l lines] [-p prompt] [-fn font] [-m monitor]
# This one writes nothing and stays open: a prompt nobody has answered yet, and
# the only prompt a test can reach the WM behind. It does not grab the keyboard.
: >"${WM_FAKE_STARTED_DIR:?set WM_FAKE_STARTED_DIR to a directory the run can write}/dmenu"
sleep 5

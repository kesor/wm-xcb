#!/usr/bin/env sh
# Runs the commit message rules. See docs/QUALITY.md.
#
# The rule is one script, so this hook can run it directly when the dev shell is
# not active.
set -u

if [ "${WM_HOOKS:-1}" = "0" ]; then
  echo "wm: WM_HOOKS=0, skipping the commit message rules"
  exit 0
fi

if command -v lefthook >/dev/null 2>&1; then
  exec lefthook run commit-msg "$@"
fi

root=$(git rev-parse --show-toplevel)
exec "$root/scripts/check-commit-msg.sh" "$@"

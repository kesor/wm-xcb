wm
*.o
build/
compile_commands.json
*.plist
*.d
compile_flags.txt
task-*.txt

# Test binaries - ignore all test-* then un-ignore source files
test-*
!tests/unit/test-*.c
!tests/unit/test-*.h
!tests/x/test-*.sh
# A fuzz harness is a test-* shape under another name, and a crash artifact is
# build output that belongs in build/ (already ignored).
!tests/fuzz/fuzz-*.c
test
pr-body.md
result

# direnv cache
.direnv/

# Compiled objects the coverage and fuzz gates keep between runs.
.cache/

# Test tool binaries (tools/xclient is built from tools/xclient.c)
tools/xclient
tools/xcb-ewmh-delay.so

# Worker worktrees created by the worker harness (worker.sh start <bead>)
.worktrees/

# Beads passive export: regenerated on every bd command, synced through
# refs/dolt/data. Tracking it would put a rewritten file in every worktree.
.beads/issues.jsonl

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
